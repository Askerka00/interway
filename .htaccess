DirectorySlash Off
RewriteEngine On

# Redirect www and HTTP to https://interway.kz
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.interway\.kz$ [NC]
RewriteRule ^ https://interway.kz%{REQUEST_URI} [R=301,L]

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://interway.kz/ [R=301,L]

# Remove trailing slash (except root /)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ https://interway.kz/$1 [R=301,L]

# Serve static Nuxt directory index.html without trailing slash redirect
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]
